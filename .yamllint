extends: default

# Sloth output is checked with promtool; Helm templates only become YAML once
# rendered, so helm lint checks them instead; the chart's rule files are
# copies, linted at their source.
ignore: |
  platform/prometheus/rules/slo-*.yml
  deploy/k8s/charts/*/templates/
  deploy/k8s/charts/*/files/

rules:
  document-start: disable
  # GitHub Actions uses "on:" as a key.
  truthy:
    check-keys: false
  line-length:
    max: 120
